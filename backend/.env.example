# Copy to .env and fill in. The DATABASE_URL below matches the Postgres
# started by `docker compose up -d` at the repo root.
DATABASE_URL="postgresql://tienda:tienda@localhost:5432/tienda_online?schema=public"

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Storefront URL — Stripe Checkout's success/cancel redirect lands here.
# Keep in sync with CORS_ORIGIN.
STORE_APP_URL=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Google OAuth2 — only the Client ID (console.cloud.google.com -> Auth
# Platform -> Clients -> Create Client -> Web application). We verify Google
# Identity Services ID tokens client-side, so no secret/callback URL needed.
# Set the JavaScript origin to your frontend URL (e.g. http://localhost:3000).
GOOGLE_CLIENT_ID=

# Stripe (test mode — dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=pyg

# Brevo transactional email (app.brevo.com -> SMTP & API -> API Keys).
# Left empty, invite/order emails just log to console instead of sending.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Tienda Online

# Local file storage for product images / logos / comprobantes
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/uploads

# First Super Admin created by prisma/seed.ts
SEED_SUPER_ADMIN_EMAIL=admin@tienda.com
SEED_SUPER_ADMIN_PASSWORD=CambiarEsta123!
